#!/usr/bin/python3
"""Validate representative generated configurations with the pinned Blocky binary."""

import importlib.util
import json
from pathlib import Path
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]
MODULE_PATH = ROOT / "packaging/ipfire/src/blocky/blocky_manager.py"
SPEC = importlib.util.spec_from_file_location("blocky_manager", MODULE_PATH)
manager = importlib.util.module_from_spec(SPEC)
assert SPEC.loader is not None
SPEC.loader.exec_module(manager)


def main():
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} /path/to/blocky", file=sys.stderr)
        return 2
    binary = Path(sys.argv[1]).resolve()
    version = subprocess.run(
        [binary, "version"], check=True, text=True, capture_output=True
    ).stdout
    if "Version: v0.35.0" not in version:
        raise RuntimeError("validation binary is not Blocky v0.35.0")

    overlay = ROOT / "packaging/ipfire/config/blocky"
    config = json.loads((overlay / "default-config.json").read_text())
    settings = json.loads((overlay / "default-settings.json").read_text())
    catalog = json.loads((overlay / "doh-providers.json").read_text())
    network = {
        "GREEN_DEV": "green0",
        "GREEN_ADDRESS": "192.0.2.1",
        "GREEN_NETADDRESS": "192.0.2.0",
        "GREEN_NETMASK": "255.255.255.0",
        "BLUE_DEV": "blue0",
        "BLUE_ADDRESS": "198.51.100.1",
        "BLUE_NETADDRESS": "198.51.100.0",
        "BLUE_NETMASK": "255.255.255.0",
    }
    candidates = [(config, settings)]
    enforced = json.loads(json.dumps(settings))
    for zone in enforced["zones"].values():
        zone.update(selected=True, route=True, bypass=True)
    enforced["doh"]["providers"] = [item["id"] for item in catalog["providers"]]
    enforced["doh"]["customDomains"] = ["doh.example.invalid"]
    enforced["doh"]["customIPv4"] = ["203.0.113.53/32"]
    candidates.append((config, enforced))

    with tempfile.TemporaryDirectory(prefix="blocky-validation-") as temporary:
        for index, (candidate_config, candidate_settings) in enumerate(candidates):
            runtime, _ = manager.build_runtime(
                candidate_config, candidate_settings, network, catalog
            )
            path = Path(temporary) / f"candidate-{index}.yml"
            path.write_bytes(manager.generated_config_bytes(runtime))
            subprocess.run(
                [binary, "--config", path, "validate"],
                check=True,
                text=True,
            )
    print("Validated inert and enforced generated configurations with Blocky v0.35.0.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
